{
  "name": "Lumi Wellness | مدیریت هوشمند باشگاه ورزشی",
  "short_name": "Lumi Wellness",
  "description": "پلتفرم جامع مدیریت باشگاه، مربیان و ورزشکاران — برنامه تمرینی، اشتراک، چک‌این و گزارش‌گیری",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "orientation": "portrait-primary",
  "background_color": "#0c0e12",
  "theme_color": "#0c0e12",
  "lang": "fa",
  "dir": "rtl",
  "categories": [
    "fitness",
    "health",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
